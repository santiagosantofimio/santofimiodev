---
import { ArrowUpRightIcon, ChartBarIcon, SwatchesIcon } from "@phosphor-icons/react/ssr";
import LogoMarca from "@/componentes/LogoMarca.astro";
import OrdenarDemo from "@/islas/OrdenarDemo";
import { perfil } from "@/datos/perfil";
import { proyectos } from "@/datos/proyectos";

const [sorting, estaPagina] = proyectos;

// Pares de color que mide la tarjeta de esta página, en el tema que esté activo.
const pares = [
  { etiqueta: "Texto sobre fondo", texto: "texto", fondo: "fondo" },
  { etiqueta: "Texto suave sobre fondo", texto: "texto-suave", fondo: "fondo" },
  { etiqueta: "Botón principal", texto: "sobre-acento", fondo: "acento" },
];
---

<section id="proyectos" tabindex="-1" aria-labelledby="titulo-proyectos" class="scroll-mt-16 py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="flex flex-wrap items-end justify-between gap-6" data-aparece>
      <h2 id="titulo-proyectos" class="text-titulo-2 font-extrabold">Proyectos</h2>
      <a
        href={perfil.github}
        target="_blank"
        rel="noopener"
        class="enlace inline-flex min-h-11 items-center gap-2 text-pequeno text-texto-suave"
      >
        Más en mi GitHub
        <ArrowUpRightIcon size={16} aria-hidden="true" className="flecha" />
      </a>
    </div>

    <ul class="mt-12 grid gap-4 md:mt-16 lg:grid-cols-12">
      <li class="lg:col-span-7" data-aparece>
        <article class="tarjeta h-full" data-luz data-inclinar>
          <div class="nucleo flex flex-col gap-8 p-6 md:p-8">
            <header class="flex items-start justify-between gap-4">
              <div class="flex items-center gap-4">
                <span class="icono-tarjeta">
                  <ChartBarIcon size={22} aria-hidden="true" />
                </span>
                <h3 class="text-titulo-3 font-bold">
                  <a href={sorting.repositorio} target="_blank" rel="noopener" class="inline-flex items-center gap-2">
                    {sorting.nombre}
                    <ArrowUpRightIcon size={20} aria-hidden="true" className="flecha text-texto-suave" />
                    <span class="sr-only">(repositorio en GitHub)</span>
                  </a>
                </h3>
              </div>
            </header>

            <div class="rounded-base border border-linea bg-fondo p-4 md:p-5">
              <OrdenarDemo client:visible={{ rootMargin: "300px" }} />
              <p class="mt-4 text-etiqueta text-texto-suave">
                Versión en miniatura hecha para esta página. En el proyecto real, los pasos los calcula una API de
                Spring Boot.
              </p>
            </div>

            <div>
              <p class="max-w-[60ch] text-texto-suave">{sorting.descripcion}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {
                  sorting.tecnologias.map(({ nombre, logo }) => (
                    <li class="etiqueta">
                      <LogoMarca logo={logo} class="text-[0.95rem]" />
                      {nombre}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </article>
      </li>

      <li class="lg:col-span-5" data-aparece style="--retraso: 90ms">
        <article class="tarjeta h-full" data-luz data-inclinar>
          <div class="nucleo flex flex-col gap-8 p-6 md:p-8">
            <header class="flex items-center gap-4">
              <span class="icono-tarjeta">
                <SwatchesIcon size={22} aria-hidden="true" />
              </span>
              <h3 class="text-titulo-3 font-bold">
                <a href={estaPagina.repositorio} target="_blank" rel="noopener" class="inline-flex items-center gap-2">
                  {estaPagina.nombre}
                  <ArrowUpRightIcon size={20} aria-hidden="true" className="flecha text-texto-suave" />
                  <span class="sr-only">(repositorio en GitHub)</span>
                </a>
              </h3>
            </header>

            <p class="text-texto-suave">{estaPagina.descripcion}</p>

            <div class="rounded-base border border-linea bg-fondo p-4 md:p-5">
              <p class="font-mono text-etiqueta text-texto-suave">Contraste del tema actual, medido en vivo</p>
              <dl class="mt-4 flex flex-col gap-3">
                {
                  pares.map(({ etiqueta, texto, fondo }) => (
                    <div data-contraste={`${texto},${fondo}`} class="flex items-center justify-between gap-3">
                      <dt class="flex items-center gap-3 text-pequeno">
                        <span class="muestra" style={`background: var(--${fondo})`} aria-hidden="true">
                          <span class="m-auto size-2 rounded-[1px]" style={`background: var(--${texto})`} />
                        </span>
                        {etiqueta}
                      </dt>
                      <dd class="flex items-center gap-2 font-mono text-etiqueta">
                        <span data-valor></span>
                        <span data-nivel-texto class="rounded-[0.25rem] border border-linea-fuerte px-1.5 py-0.5" />
                      </dd>
                    </div>
                  ))
                }
              </dl>
              <button type="button" data-probar-tema class="boton boton-secundario boton-compacto mt-5 w-full">
                Probar en el otro tema
              </button>
            </div>

            <ul class="mt-auto flex flex-wrap gap-2">
              {
                estaPagina.tecnologias.map(({ nombre, logo }) => (
                  <li class="etiqueta">
                    <LogoMarca logo={logo} class="text-[0.95rem]" />
                    {nombre}
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
      </li>
    </ul>
  </div>
</section>
