---
import { ArrowDownIcon, ArrowUpRightIcon, WhatsappLogoIcon } from "@phosphor-icons/react/ssr";

interface Props {
  href: string;
  variante?: "primario" | "secundario";
  /** Icono en su propia pieza, pegada al borde derecho del botón. */
  pieza?: "abajo" | "diagonal" | "whatsapp";
  compacto?: boolean;
  magnetico?: boolean;
  class?: string;
}

const { href, variante = "primario", pieza, compacto = false, magnetico = false, class: clase } = Astro.props;
const externo = href.startsWith("http");
const Icono = pieza === "abajo" ? ArrowDownIcon : pieza === "whatsapp" ? WhatsappLogoIcon : ArrowUpRightIcon;
---

<a
  href={href}
  class:list={["boton", `boton-${variante}`, compacto && "boton-compacto", pieza && "boton-con-pieza", clase]}
  target={externo ? "_blank" : undefined}
  rel={externo ? "noopener" : undefined}
  data-magnetico={magnetico ? "" : undefined}
>
  <slot />
  {
    pieza && (
      <span class="boton-pieza" aria-hidden="true">
        <Icono size={18} className={pieza === "abajo" ? "pieza-abajo" : "pieza-diagonal"} />
      </span>
    )
  }
</a>
