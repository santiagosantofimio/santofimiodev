---
import type { Icon } from "@phosphor-icons/react";
import { ArrowsClockwiseIcon, MegaphoneIcon, StorefrontIcon, WrenchIcon } from "@phosphor-icons/react/ssr";
import { servicios } from "@/datos/servicios";

const iconos: Record<string, Icon> = {
  "una-pagina": StorefrontIcon,
  campana: MegaphoneIcon,
  rediseno: ArrowsClockwiseIcon,
  mantenimiento: WrenchIcon,
};

// Grilla asimétrica: el encargo más común ocupa más y va invertido.
const anchos = ["lg:col-span-4", "lg:col-span-2", "lg:col-span-2", "lg:col-span-4"];
---

<section id="servicios" tabindex="-1" aria-labelledby="titulo-servicios" class="scroll-mt-16 py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-servicios" class="text-titulo-2 font-extrabold">Qué hago</h2>
      <p class="mt-5 text-entrada text-texto-suave">
        Cuatro tipos de encargo. Si lo tuyo no encaja en ninguno, escríbeme igual y lo miramos.
      </p>
    </div>

    <ul class="mt-14 grid gap-3 md:mt-16 md:grid-cols-2 lg:grid-cols-6">
      {
        servicios.map((servicio, indice) => {
          const Icono = iconos[servicio.id] ?? StorefrontIcon;
          const invertida = indice === 0;
          return (
            <li data-aparece style={`--retraso: ${indice * 80}ms`} class={anchos[indice]}>
              <article
                data-luz
                class:list={["tarjeta flex h-full flex-col p-6 md:p-8", invertida && "tarjeta-invertida"]}
              >
                <span class="icono-tarjeta">
                  <Icono size={24} weight="bold" aria-hidden="true" />
                </span>
                <h3 class="mt-10 text-titulo-3 font-bold">{servicio.nombre}</h3>
                <p class:list={["mt-2 text-pequeno font-semibold", invertida ? "" : "text-texto"]}>
                  {servicio.paraQuien}
                </p>
                <p class:list={["mt-4 max-w-[48ch] texto-secundario", !invertida && "text-texto-suave"]}>
                  {servicio.incluye}
                </p>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
