---
import CambiarIdioma from "@/componentes/CambiarIdioma.astro";
import AlternarTema from "@/islas/AlternarTema";
import MenuCelular from "@/islas/MenuCelular";
import { perfil } from "@/datos/perfil";
import { idiomaDe } from "@/i18n/idiomas";
import { textos } from "@/i18n/textos";

const idioma = idiomaDe(Astro.currentLocale);
const t = textos[idioma].navegacion;

const enlaces = [
  { href: "#sobre-mi", texto: t.sobreMi },
  { href: "#proyectos", texto: t.proyectos },
  { href: "#tecnologias", texto: t.tecnologias },
  { href: "#contacto", texto: t.contacto },
];
---

<header data-navbar class="sticky top-0 z-30 h-16">
  <div aria-hidden="true" class="navbar-isla absolute inset-y-1.5"></div>
  <div aria-hidden="true" class="progreso-lectura absolute bottom-1.5"></div>
  <div
    class="relative mx-auto flex h-full max-w-[1400px] items-center justify-between gap-6 px-margen"
  >
    <a href="#inicio" class="flex min-h-11 items-center gap-2.5 font-display text-[1.0625rem] font-bold tracking-[-0.02em]">
      <span
        aria-hidden="true"
        class="inline-flex size-7 items-center justify-center rounded-[0.3125rem] bg-acento text-[0.9375rem] font-extrabold text-sobre-acento"
        >S.</span
      >
      <span class="hidden min-[400px]:inline">{perfil.nombre}</span>
    </a>

    <nav aria-label={t.etiqueta} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          enlaces.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class="inline-flex min-h-11 items-center text-pequeno text-texto-suave transition-[color] duration-(--duracion-media) ease-salida hover:text-texto"
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <CambiarIdioma />
      <AlternarTema client:idle idioma={idioma} />
      <a href={`mailto:${perfil.correo}`} data-magnetico class="boton boton-primario boton-compacto hidden lg:inline-flex">
        {t.escribeme}
      </a>
      <div class="lg:hidden">
        <MenuCelular client:media="(max-width: 1023px)" enlaces={enlaces} correo={perfil.correo} idioma={idioma} />
      </div>
    </div>
  </div>
</header>

<script>
  // Compacta la navbar cuando el centinela del tope sale de la pantalla.
  const navbar = document.querySelector<HTMLElement>("[data-navbar]");
  const centinela = document.querySelector("[data-centinela]");

  if (navbar && centinela) {
    new IntersectionObserver(([entrada]) => {
      navbar.dataset.compacto = String(!entrada.isIntersecting);
    }).observe(centinela);
  }
</script>
