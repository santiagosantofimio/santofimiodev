---
import { proceso } from "@/datos/proceso";
---

<section id="proceso" tabindex="-1" aria-labelledby="titulo-proceso" class="scroll-mt-16 py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-proceso" class="text-titulo-2 font-extrabold">Cómo trabajo</h2>
      <p class="mt-5 text-entrada text-texto-suave">
        El miedo normal al contratar una página es pagar y que la persona desaparezca. Por eso todo va por
        escrito y ves el avance mientras lo construyo.
      </p>
    </div>

    <ol class="mt-14 grid gap-x-6 gap-y-10 md:mt-20 md:grid-cols-2 lg:grid-cols-4">
      {
        proceso.map((paso, indice) => (
          <li data-aparece style={`--retraso: ${indice * 70}ms`} class="border-t border-linea-fuerte pt-6">
            <span aria-hidden="true" class="font-mono text-etiqueta text-acento">
              {indice + 1}
            </span>
            <h3 class="mt-4 text-titulo-3 font-bold">{paso.titulo}</h3>
            <p class="mt-3 text-texto-suave">{paso.detalle}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
