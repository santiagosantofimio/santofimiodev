---
import type { Icon } from "@phosphor-icons/react";
import { ChatsCircleIcon, EyeIcon, KeyIcon, SignatureIcon } from "@phosphor-icons/react/ssr";
import { proceso } from "@/datos/proceso";

const iconos: Record<string, Icon> = {
  conversacion: ChatsCircleIcon,
  propuesta: SignatureIcon,
  construccion: EyeIcon,
  entrega: KeyIcon,
};
---

<section id="proceso" tabindex="-1" aria-labelledby="titulo-proceso" class="scroll-mt-16 py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-proceso" class="text-titulo-2 font-extrabold">Cómo trabajo</h2>
      <p class="mt-5 text-entrada text-texto-suave">
        El miedo normal al contratar una página es pagar y que la persona desaparezca. Por eso todo va por
        escrito y ves el avance mientras lo construyo.
      </p>
    </div>

    <ol class="mt-14 grid gap-y-7 md:mt-20 lg:grid-cols-4 lg:gap-x-8">
      {
        proceso.map((paso, indice) => {
          const Icono = iconos[paso.id] ?? ChatsCircleIcon;
          return (
            <li
              data-paso
              data-aparece
              style={`--retraso: ${indice * 80}ms`}
              class="paso grid grid-cols-[3rem_1fr] gap-x-5 lg:block"
            >
              <span class="paso-icono">
                <Icono size={22} weight="bold" aria-hidden="true" />
              </span>
              <div class="lg:mt-7">
                <h3 class="text-titulo-3 font-bold">{paso.titulo}</h3>
                <p class="mt-3 text-texto-suave">{paso.detalle}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
