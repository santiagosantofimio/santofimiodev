---
import { logos, type Logo } from "@/lib/logos";

interface Props {
  logo: Logo;
  /** Lado en píxeles. */
  tamano?: number;
  class?: string;
}

const { logo, tamano = 16, class: clase } = Astro.props;
const { archivo, oscuro } = logos[logo] as { archivo: string; oscuro?: boolean };
---

<img
  src={`/logos/${archivo}.svg`}
  alt=""
  width={tamano}
  height={tamano}
  loading="lazy"
  decoding="async"
  class:list={["logo", oscuro && "logo-oscuro", clase]}
/>
