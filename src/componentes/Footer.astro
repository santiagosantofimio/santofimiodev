---
import { perfil } from "@/datos/perfil";

const anio = new Date().getFullYear();

const enlaces = [
  { texto: "GitHub", href: perfil.github },
  { texto: "LinkedIn", href: perfil.linkedin },
  { texto: "Código de esta página", href: perfil.repositorio },
];
---

<footer class="border-t border-linea">
  <div
    class="mx-auto flex max-w-[1400px] flex-col gap-6 px-margen pt-8 pb-[calc(2rem+env(safe-area-inset-bottom))] md:flex-row md:items-center md:justify-between"
  >
    <p class="text-pequeno text-texto-suave">
      <span class="font-display font-bold text-texto">{perfil.nombre}</span>. {perfil.oficio} en {perfil.ciudad}. © {anio}
    </p>
    <ul class="flex flex-col text-pequeno md:flex-row md:flex-wrap md:gap-x-6">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              target="_blank"
              rel="noopener"
              class="enlace inline-flex min-h-11 items-center text-texto-suave"
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
