---
import { stack } from "@/datos/stack";
---

<section aria-labelledby="titulo-stack" class="py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-stack" class="text-titulo-2 font-extrabold">Con qué construyo</h2>
      <p class="mt-5 text-entrada text-texto-suave">Para quien quiere saber qué hay por debajo.</p>
    </div>

    <div class="mt-14 grid grid-cols-12 gap-x-6 gap-y-12 md:mt-16">
      {
        stack.map((grupo, indice) => (
          <div
            data-aparece
            style={`--retraso: ${indice * 90}ms`}
            class:list={["col-span-12", grupo.id === "hoy" ? "lg:col-span-7" : "lg:col-span-4 lg:col-start-9"]}
          >
            <h3 class="text-titulo-3 font-bold">{grupo.titulo}</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {grupo.items.map((item) => (
                <li class:list={["etiqueta", grupo.id === "aprendiendo" && "etiqueta-aprendiendo"]}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
