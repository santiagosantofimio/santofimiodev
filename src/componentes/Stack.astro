---
import type { Icon } from "@phosphor-icons/react";
import { DeviceMobileIcon, GaugeIcon, PersonArmsSpreadIcon } from "@phosphor-icons/react/ssr";
import LogoMarca from "@/componentes/LogoMarca.astro";
import { stack, type IconoStack } from "@/datos/stack";
import { logos, type Logo } from "@/lib/logos";

const iconos: Record<IconoStack, Icon> = {
  movil: DeviceMobileIcon,
  accesibilidad: PersonArmsSpreadIcon,
  rendimiento: GaugeIcon,
};

// La cinta muestra solo lo que uso hoy, un logo por herramienta.
const hoy = stack.find((grupo) => grupo.id === "hoy")?.items ?? [];
const cinta: { logo: Logo; nombre: string }[] = hoy.flatMap((item) =>
  (item.logos ?? []).map((logo) => ({ logo, nombre: logo === "openjdk" ? "Java" : logos[logo].title })),
);
---

<section aria-labelledby="titulo-stack" class="py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-stack" class="text-titulo-2 font-extrabold">Con qué construyo</h2>
      <p class="mt-5 text-entrada text-texto-suave">Para quien quiere saber qué hay por debajo.</p>
    </div>
  </div>

  <div class="cinta mt-14 border-y border-linea py-6 md:mt-16" data-pausable aria-hidden="true">
    <div class="cinta-pista">
      {
        [0, 1].map((copia) => (
          <ul class:list={["flex shrink-0 items-center gap-12 pr-12", copia === 1 && "cinta-copia"]}>
            {cinta.map(({ logo, nombre }) => (
              <li class="flex items-center gap-3 font-mono text-pequeno whitespace-nowrap text-texto-suave">
                <LogoMarca logo={logo} class="text-[1.75rem] text-texto" />
                {nombre}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <div class="mx-auto mt-14 grid max-w-[1400px] grid-cols-12 gap-x-6 gap-y-12 px-margen md:mt-16">
    {
      stack.map((grupo, indice) => (
        <div
          data-aparece
          style={`--retraso: ${indice * 90}ms`}
          class:list={["col-span-12", grupo.id === "hoy" ? "lg:col-span-7" : "lg:col-span-4 lg:col-start-9"]}
        >
          <h3 class="text-titulo-3 font-bold">{grupo.titulo}</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {grupo.items.map((item) => {
              const Icono = item.icono ? iconos[item.icono] : null;
              return (
                <li class:list={["etiqueta gap-2", grupo.id === "aprendiendo" && "etiqueta-aprendiendo"]}>
                  {item.logos?.map((logo) => <LogoMarca logo={logo} class="text-[0.95rem]" />)}
                  {Icono && <Icono size={16} weight="bold" aria-hidden="true" />}
                  {item.nombre}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>
