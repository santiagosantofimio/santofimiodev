---
import type { Icon } from "@phosphor-icons/react";
import { CodeIcon, GraduationCapIcon, LaptopIcon } from "@phosphor-icons/react/ssr";
import { formacion, parrafos, type Formacion } from "@/datos/sobre-mi";

const iconos: Record<Formacion["id"], Icon> = {
  universidad: GraduationCapIcon,
  cursos: LaptopIcon,
  propios: CodeIcon,
};

// Giro de cada tarjeta de la cascada, solo desde lg.
const giros = ["-2deg", "1.5deg", "-1deg"];
const [primero, ...resto] = parrafos;
---

<section id="sobre-mi" tabindex="-1" aria-labelledby="titulo-sobre-mi" class="scroll-mt-16 py-seccion">
  <div class="mx-auto grid max-w-[1400px] grid-cols-12 gap-x-6 gap-y-14 px-margen">
    <div class="col-span-12 lg:col-span-7">
      <h2 id="titulo-sobre-mi" class="text-titulo-2 font-extrabold" data-aparece>Sobre mí</h2>
      <p class="mt-8 max-w-[34ch] font-display text-titulo-3 font-semibold" data-aparece style="--retraso: 80ms">
        {primero}
      </p>
      <div class="mt-8 flex max-w-[58ch] flex-col gap-5 text-entrada text-texto-suave">
        {
          resto.map((parrafo, indice) => (
            <p data-aparece style={`--retraso: ${140 + indice * 60}ms`}>
              {parrafo}
            </p>
          ))
        }
      </div>
    </div>

    <div class="col-span-12 lg:col-span-4 lg:col-start-9 lg:pt-24">
      <h3 class="font-mono text-etiqueta text-texto-suave" data-aparece>Cómo aprendí</h3>
      <ul class="cascada mt-5 flex flex-col gap-3 lg:gap-0">
        {
          formacion.map((item, indice) => {
            const Icono = iconos[item.id];
            return (
              <li style={`--giro: ${giros[indice]}`} class="relative">
                <div data-aparece style={`--retraso: ${indice * 90}ms`}>
                  <div class="tarjeta" data-luz>
                    <div class="nucleo flex items-center gap-4 p-5">
                      <span class="icono-tarjeta shrink-0">
                        <Icono size={22} aria-hidden="true" />
                      </span>
                      <div>
                        <p class="font-display text-entrada font-bold">{item.titulo}</p>
                        <p class="text-pequeno text-texto-suave">{item.detalle}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
