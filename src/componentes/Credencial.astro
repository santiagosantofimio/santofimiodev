---
import { MapPinIcon } from "@phosphor-icons/react/ssr";
import QRCode from "qrcode";
import LogoMarca from "@/componentes/LogoMarca.astro";
import Marca from "@/componentes/Marca.astro";
import { perfil } from "@/datos/perfil";
import type { Logo } from "@/lib/logos";
import { idiomaDe } from "@/i18n/idiomas";
import { textos } from "@/i18n/textos";

// El QR se arma al compilar y lleva a LinkedIn: sirve para escanearlo desde el celular.
const qr = (
  await QRCode.toString(perfil.linkedin, {
    type: "svg",
    margin: 0,
    errorCorrectionLevel: "M",
    color: { dark: "#000000", light: "#0000" },
  })
).replace(/stroke="#000000"/g, 'stroke="currentColor"');

const stack: Logo[] = ["java", "spring", "react", "typescript", "angular"];
const [nombre, apellido] = perfil.nombre.split(" ");
const idioma = idiomaDe(Astro.currentLocale);
---

<div class="credencial-escena" data-credencial data-pausable>
  <div class="credencial-balanceo">
    <div class="credencial-pendulo" data-pendulo>
      <div class="credencial-cinta" aria-hidden="true">
        <span>santofimiodev santofimiodev santofimiodev santofimiodev santofimiodev</span>
      </div>
      <div class="credencial-broche" aria-hidden="true"></div>

      <div
        class="credencial-tarjeta"
        data-tarjeta
        role="img"
        aria-label={textos[idioma].hero.credencial(perfil.nombre, perfil.rol, perfil.ciudad)}
      >
        <div class="credencial-ranura" aria-hidden="true"></div>

        <div class="flex items-center justify-between font-mono text-[0.6875rem] text-tinta-suave">
          <span>santofimiodev</span>
          <Marca class="text-[0.9375rem] text-tinta" />
        </div>

        <div class="credencial-foto mt-4" aria-hidden="true">
          <Marca />
        </div>

        <p class="mt-5 font-display text-[1.625rem] leading-[1.05] font-extrabold tracking-[-0.03em]">
          {nombre}<br />{apellido}
        </p>
        <p class="mt-1.5 font-display text-[0.9375rem] font-semibold text-tinta-suave">{perfil.rol}</p>
        <p class="mt-3 flex items-center gap-1.5 text-[0.8125rem] text-tinta-suave">
          <MapPinIcon size={14} aria-hidden="true" />
          {perfil.ciudad}, {perfil.pais[idioma]}
        </p>

        <div class="mt-5 flex items-end justify-between gap-3 border-t border-[color-mix(in_oklab,var(--tinta)_14%,transparent)] pt-4">
          <div>
            <p class="font-mono text-[0.625rem] text-tinta-suave">Stack</p>
            <div class="mt-2 flex items-center gap-2">
              {stack.map((logo) => <LogoMarca logo={logo} tamano={20} />)}
            </div>
          </div>
          <div class="flex flex-col items-end gap-1.5">
            <div class="credencial-qr" set:html={qr} />
            <p class="font-mono text-[0.625rem] text-tinta-suave">LinkedIn</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
