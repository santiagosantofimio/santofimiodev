---
import Estimador from "@/islas/Estimador";
---

<section
  id="presupuesto"
  tabindex="-1"
  aria-labelledby="titulo-presupuesto"
  class="scroll-mt-16 border-y border-linea py-seccion"
>
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-presupuesto" class="text-titulo-2 font-extrabold">Cuánto te costaría</h2>
      <p class="mt-5 text-entrada text-texto-suave">
        Cuatro preguntas y ves el rango de precio y de tiempo. Si te sirve, me lo mandas por WhatsApp con un
        clic y seguimos desde ahí.
      </p>
    </div>
    <div class="mt-14 md:mt-16">
      <Estimador client:visible={{ rootMargin: "400px" }} />
    </div>
  </div>
</section>
