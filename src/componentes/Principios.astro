---
import type { Icon } from "@phosphor-icons/react";
import { ArrowUpRightIcon, DeviceMobileIcon, GitCommitIcon, LightningIcon, PersonArmsSpreadIcon } from "@phosphor-icons/react/ssr";
import { perfil } from "@/datos/perfil";
import { principios, type Principio } from "@/datos/principios";

const iconos: Record<Principio["id"], Icon> = {
  movil: DeviceMobileIcon,
  accesible: PersonArmsSpreadIcon,
  rapido: LightningIcon,
  historial: GitCommitIcon,
};
---

<section aria-labelledby="titulo-principios" class="py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-principios" class="text-titulo-2 font-extrabold">Cómo trabajo</h2>
      <p class="mt-5 text-entrada text-texto-suave">
        Cuatro costumbres que se pueden comprobar en el código de esta misma página.
      </p>
    </div>

    <ol class="mt-14 grid gap-y-7 md:mt-20 lg:grid-cols-4 lg:gap-x-8">
      {
        principios.map((principio, indice) => {
          const Icono = iconos[principio.id];
          return (
            <li
              data-paso
              data-aparece
              style={`--retraso: ${indice * 80}ms`}
              class="paso grid grid-cols-[3rem_1fr] gap-x-5 lg:block"
            >
              <span class="paso-icono">
                <Icono size={22} aria-hidden="true" />
              </span>
              <div class="lg:mt-7">
                <h3 class="text-titulo-3 font-bold">{principio.titulo}</h3>
                <p class="mt-3 text-texto-suave">{principio.detalle}</p>
                {principio.prueba && (
                  <a
                    href={`${perfil.repositorio}${principio.prueba.ruta}`}
                    target="_blank"
                    rel="noopener"
                    class="enlace mt-3 inline-flex min-h-11 items-center gap-1.5 text-pequeno"
                  >
                    {principio.prueba.texto}
                    <ArrowUpRightIcon size={14} aria-hidden="true" className="flecha" />
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
