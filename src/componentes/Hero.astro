---
import Boton from "@/componentes/Boton.astro";
import PantallaNegocio from "@/componentes/PantallaNegocio.astro";
import { enlaceWhatsApp, TEXTO_CTA_WHATSAPP } from "@/lib/whatsapp";

const palabras = "Hago la página web de tu negocio en Bogotá.".split(" ");
---

<section id="inicio" tabindex="-1" aria-labelledby="titulo-inicio" class="relative isolate overflow-x-clip">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 right-0 -z-10 h-[40rem] w-[min(60rem,100%)] bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--texto)_7%,transparent),transparent)]"
  >
  </div>
  <div
    class="mx-auto grid max-w-[1400px] grid-cols-12 items-center gap-x-6 gap-y-16 px-margen pt-12 pb-20 md:pt-16 lg:min-h-[calc(100svh-4rem)] lg:pt-10 lg:pb-16"
  >
    <div class="col-span-12 lg:col-span-7">
      <h1 id="titulo-inicio" class="text-titulo-hero font-extrabold">
        {
          palabras.map((palabra, indice) => (
            <>
              <span class="palabra" style={`--i: ${indice}`}>
                {palabra}
              </span>{" "}
            </>
          ))
        }
      </h1>
      <p class="entrada mt-8 max-w-[34ch] text-entrada text-texto-suave" style="--retraso: 420ms">
        Se ve bien en el celular y sabes cuánto cuesta antes de que empiece a construirla.
      </p>
      <div class="entrada mt-8 grid gap-3 sm:flex sm:flex-wrap" style="--retraso: 520ms">
        <Boton href={enlaceWhatsApp("general")} icono="whatsapp">{TEXTO_CTA_WHATSAPP}</Boton>
        <Boton href="#presupuesto" variante="secundario" icono="abajo">Calcula el precio</Boton>
      </div>
    </div>

    <div class="col-span-12 lg:col-span-5">
      <PantallaNegocio />
    </div>
  </div>
</section>
