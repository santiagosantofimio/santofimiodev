---
import Boton from "@/componentes/Boton.astro";
import Credencial from "@/componentes/Credencial.astro";
import { perfil } from "@/datos/perfil";
import { idiomaDe } from "@/i18n/idiomas";
import { textos } from "@/i18n/textos";

const t = textos[idiomaDe(Astro.currentLocale)];

const [nombre, apellido] = perfil.nombre.split(" ");
let indice = 0;
const lineas = [nombre, apellido].map((palabra) => [...palabra].map((letra) => ({ letra, i: indice++ })));
---

<section id="inicio" tabindex="-1" aria-labelledby="titulo-inicio" class="relative isolate overflow-x-clip">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[44rem] w-[min(80rem,140%)] -translate-x-1/2 bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--texto)_6%,transparent),transparent)]"
  >
  </div>

  <div
    class="mx-auto grid max-w-[1400px] grid-cols-12 gap-x-6 gap-y-4 px-margen pt-10 pb-20 md:pt-16 lg:min-h-[calc(100svh-4rem)] lg:items-center lg:pt-0 lg:pb-16"
  >
    <div class="col-span-12 lg:col-span-8">
      <h1 id="titulo-inicio" class="text-nombre select-none" data-nombre>
        <span class="sr-only">{perfil.nombre}</span>
        <span aria-hidden="true" class="block">
          {
            lineas.map((linea) => (
              <span class="block whitespace-nowrap">
                {linea.map(({ letra, i }) => (
                  <span class="letra" data-letra style={`--i: ${i}`}>
                    {letra}
                  </span>
                ))}
              </span>
            ))
          }
        </span>
      </h1>

      <p class="entrada mt-6 font-display text-titulo-3 font-semibold text-texto-suave md:mt-8" style="--retraso: 700ms">
        {perfil.rol}
      </p>

      <div class="entrada mt-10 grid gap-3 sm:flex sm:flex-wrap" style="--retraso: 820ms">
        <Boton href="#proyectos" pieza="abajo" magnetico>{t.hero.verProyectos}</Boton>
        <Boton href={`mailto:${perfil.correo}`} variante="secundario" magnetico>{t.navegacion.escribeme}</Boton>
      </div>
    </div>

    <div class="col-span-12 mt-10 [--largo-cinta:4rem] lg:col-span-4 lg:self-start lg:[--largo-cinta:clamp(5rem,14vh,8rem)] xl:-mt-16 xl:[--largo-cinta:clamp(9rem,26vh,15rem)]">
      <Credencial />
    </div>
  </div>
</section>
