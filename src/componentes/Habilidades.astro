---
import type { Icon } from "@phosphor-icons/react";
import {
  BrowsersIcon,
  DatabaseIcon,
  GaugeIcon,
  GitBranchIcon,
} from "@phosphor-icons/react/ssr";
import LogoMarca from "@/componentes/LogoMarca.astro";
import { habilidades, type Habilidad } from "@/datos/habilidades";
import { stack } from "@/datos/stack";
import { logos, type Logo } from "@/lib/logos";

const iconos: Record<Habilidad["id"], Icon> = {
  frontend: BrowsersIcon,
  backend: DatabaseIcon,
  calidad: GaugeIcon,
  despliegue: GitBranchIcon,
};

// Grilla asimétrica: frontend ocupa más, que es donde está la mayor parte del trabajo.
const anchos = ["lg:col-span-7", "lg:col-span-5", "lg:col-span-5", "lg:col-span-7"];

const hoy = stack.find((grupo) => grupo.id === "hoy")?.items ?? [];
const aprendiendo = stack.find((grupo) => grupo.id === "aprendiendo");
const cinta: { logo: Logo; nombre: string }[] = hoy.flatMap((item) =>
  item.logos.map((logo) => ({ logo, nombre: logo === "openjdk" ? "Java" : logos[logo].title })),
);
---

<section id="habilidades" tabindex="-1" aria-labelledby="titulo-habilidades" class="scroll-mt-16 py-seccion">
  <div class="mx-auto max-w-[1400px] px-margen">
    <div class="max-w-[40rem]" data-aparece>
      <h2 id="titulo-habilidades" class="text-titulo-2 font-extrabold">Lo que sé hacer</h2>
      <p class="mt-5 text-entrada text-texto-suave">
        Lo uso en proyectos propios y en esta página. Lo que todavía estoy aprendiendo va aparte, más abajo.
      </p>
    </div>

    <ul class="mt-12 grid gap-4 md:mt-16 md:grid-cols-2 lg:grid-cols-12">
      {
        habilidades.map((habilidad, indice) => {
          const Icono = iconos[habilidad.id];
          return (
            <li data-aparece style={`--retraso: ${indice * 80}ms`} class={anchos[indice]}>
              <article class="tarjeta h-full" data-luz>
                <div class="nucleo flex h-full flex-col p-6 md:p-8">
                  <div class="flex items-start justify-between gap-4">
                    <span class="icono-tarjeta">
                      <Icono size={22} aria-hidden="true" />
                    </span>
                    {habilidad.logos.length > 0 && (
                      <span class="flex items-center gap-3 text-[1.375rem] text-texto-suave">
                        {habilidad.logos.map((logo) => (
                          <LogoMarca logo={logo} />
                        ))}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-10 text-titulo-3 font-bold">{habilidad.titulo}</h3>
                  <p class="mt-3 max-w-[52ch] text-texto-suave">{habilidad.detalle}</p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="cinta mt-16 border-y border-linea py-6 md:mt-20" data-pausable aria-hidden="true">
    <div class="cinta-pista">
      {
        [0, 1].map((copia) => (
          <ul class:list={["flex shrink-0 items-center gap-12 pr-12", copia === 1 && "cinta-copia"]}>
            {cinta.map(({ logo, nombre }) => (
              <li class="flex items-center gap-3 font-mono text-pequeno whitespace-nowrap text-texto-suave">
                <LogoMarca logo={logo} class="text-[1.75rem] text-texto" />
                {nombre}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  {
    aprendiendo && (
      <div class="mx-auto mt-14 max-w-[1400px] px-margen md:mt-16" data-aparece>
        <h3 class="text-titulo-3 font-bold">{aprendiendo.titulo}</h3>
        <ul class="mt-5 flex flex-wrap gap-2">
          {aprendiendo.items.map((item) => (
            <li class="etiqueta etiqueta-aprendiendo">
              {item.logos.map((logo) => (
                <LogoMarca logo={logo} class="text-[0.95rem]" />
              ))}
              {item.nombre}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
