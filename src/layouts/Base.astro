---
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@/estilos/global.css";
import { perfil } from "@/datos/perfil";
import fuenteDisplay from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";
import fuenteCuerpo from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL("/og.png", Astro.site);

const persona = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: perfil.nombre,
  jobTitle: perfil.oficio,
  url: perfil.sitio,
  email: `mailto:${perfil.correo}`,
  address: { "@type": "PostalAddress", addressLocality: perfil.ciudad, addressCountry: "CO" },
  sameAs: [perfil.github, perfil.linkedin],
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#15120f" />
    <link rel="preload" href={fuenteDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteCuerpo} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hago la página web de tu negocio en Bogotá. Santiago Santofimio." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />

    <script type="application/ld+json" set:html={JSON.stringify(persona)} />
    <script is:inline>
      (() => {
        const html = document.documentElement;
        html.classList.add("js");
        try {
          if (localStorage.getItem("tema") === "claro") {
            html.dataset.tema = "claro";
            document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#f0eee9");
          }
        } catch {
          // Sin almacenamiento disponible se queda el modo oscuro.
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="boton boton-primario fixed top-3 left-3 z-40 -translate-y-24 focus-visible:translate-y-0"
    >
      Saltar al contenido
    </a>
    <div data-centinela aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-6"></div>
    <slot />
    <script>
      import { iniciarApariciones } from "@/lib/apariciones";
      import { iniciarDesplazamiento } from "@/lib/desplazamiento";

      iniciarApariciones();
      iniciarDesplazamiento();
    </script>
  </body>
</html>
