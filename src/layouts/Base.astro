---
import "@fontsource-variable/mona-sans/standard.css";
import "@fontsource-variable/martian-mono/standard.css";
import "@/estilos/global.css";
import { perfil } from "@/datos/perfil";
import { codigos, idiomaDe, idiomas, rutas } from "@/i18n/idiomas";
import { textos } from "@/i18n/textos";
import fuentePrincipal from "@fontsource-variable/mona-sans/files/mona-sans-latin-standard-normal.woff2?url";

const idioma = idiomaDe(Astro.currentLocale);
const t = textos[idioma].pagina;
const { titulo, descripcion } = t;
const url = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(t.imagen, Astro.site);

const persona = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: perfil.nombre,
  jobTitle: perfil.rol,
  url: perfil.sitio,
  email: `mailto:${perfil.correo}`,
  address: { "@type": "PostalAddress", addressLocality: perfil.ciudad, addressCountry: "CO" },
  sameAs: [perfil.github, perfil.linkedin],
};
---

<!doctype html>
<html lang={codigos[idioma].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    {idiomas.map((otro) => <link rel="alternate" hreflang={otro} href={new URL(rutas[otro], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(rutas.es, Astro.site)} />
    <meta name="theme-color" content="#111214" />
    <link rel="preload" href={fuentePrincipal} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={codigos[idioma].og} />
    {
      idiomas
        .filter((otro) => otro !== idioma)
        .map((otro) => <meta property="og:locale:alternate" content={codigos[otro].og} />)
    }
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.imagenAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />

    <script type="application/ld+json" set:html={JSON.stringify(persona)} />
    <script is:inline>
      (() => {
        const html = document.documentElement;
        html.classList.add("js");
        try {
          if (localStorage.getItem("tema") === "claro") {
            html.dataset.tema = "claro";
            document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#e9eaec");
          }
        } catch {
          // Sin almacenamiento disponible se queda el modo oscuro.
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="boton boton-primario fixed top-3 left-3 z-40 -translate-y-24 focus-visible:translate-y-0"
    >
      {t.saltar}
    </a>
    <div data-centinela aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-6"></div>
    <slot />
    <script>
      import { iniciarApariciones } from "@/lib/apariciones";
      import { iniciarCarpeta } from "@/lib/carpeta";
      import { iniciarContrasteVivo } from "@/lib/contraste-vivo";
      import { iniciarCopiar } from "@/lib/copiar";
      import { iniciarCredencial } from "@/lib/credencial";
      import { iniciarDesplazamiento } from "@/lib/desplazamiento";
      import { iniciarLuz } from "@/lib/luz";
      import { iniciarMagnetico } from "@/lib/magnetico";
      import { iniciarNombre } from "@/lib/nombre";
      import { iniciarPasos } from "@/lib/pasos";
      import { iniciarPausables } from "@/lib/pausables";

      iniciarApariciones();
      iniciarDesplazamiento();
      iniciarNombre();
      iniciarLuz();
      iniciarMagnetico();
      iniciarPausables();
      iniciarPasos();
      iniciarContrasteVivo();
      iniciarCopiar();
      iniciarCarpeta();
      iniciarCredencial();
    </script>
  </body>
</html>
